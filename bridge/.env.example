# Phase 1 — none of these are required to run the tone stub locally.
PORT=8080
PIPELINE=tone            # tone | cascade (later)
LOG_LEVEL=info

# Phase 2 — live telephony (all trimmed on read; required only when dialing)
PUBLIC_URL=https://your-bridge.up.railway.app
TOKEN_SIGNING_SECRET=    # long random string; signs attempt (30m) + call (90m) HMAC tokens
ADMIN_SECRET=            # reserved for admin/debug endpoints
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=      # shared trial number — outbound only, verified numbers only
